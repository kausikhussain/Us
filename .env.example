# K & N Anniversary Website - Environment Configuration Example
# Copy to .env.local for custom development or set in Vercel Project Settings

# Optional: Timezone override (defaults to Asia/Kolkata for Kausik & Nasreen anniversary milestone)
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata

# Optional: Client-side password protection gate toggle (default: true)
NEXT_PUBLIC_PASSWORD_ENABLED=true
