# K & N Anniversary Platform — Environment Configuration Template
# Place actual values in .env.local for local development or Vercel Environment Variables in production.
# NEVER commit production secrets or real user credentials into version control.

# Required: 64-char high-entropy HMAC-SHA256 signing secret for session tokens
ANNIVERSARY_SESSION_SECRET=e7b4c91f08a3429188d6ef7103289bf156c4d8e03a98762512f3e4d5c6b7a890

# Optional: Seed authorized users on cold start if users.json is not mounted.
# Formatted as JSON array string matching AuthorizedUser schema.
# AUTHORIZED_USERS_JSON=[{"id":"usr_example","email":"user@example.com","role":"viewer",...}]

# WebAuthn / Passkey Relying Party configuration
WEBAUTHN_RPID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_RPNAME="K & N Anniversary"

# Optional: Display timezone
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata
