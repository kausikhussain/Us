# K & N Anniversary Website - Environment Configuration Example
# Copy to .env.local for custom development or configure in Vercel Project Settings

# Anniversary Access Gate Passcode (default: 23112020 for 23 November 2020)
ANNIVERSARY_ACCESS_CODE=23112020

# Secret key used to sign HMAC-SHA256 session cookies (valid 7 days)
ANNIVERSARY_SESSION_SECRET=kn-anniversary-20201123-secret-key-celebrating-six-years-together

# Optional: Timezone override (defaults to Asia/Kolkata for K & N milestone)
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata
